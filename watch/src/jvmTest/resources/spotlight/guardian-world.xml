      <pubDate>Sun, 22 Nov 2026 08:00:22 GMT</pubDate>
      <guid>https://www.theguardian.com/news/2026/nov/22/bank-of-england-directors-illegally-profited-enslavement-cuba</guid>
      <media:content width="140" url="https://i.guim.co.uk/img/media/8e8d4ce7d37742836e3c3c5add2beb073cc8be21/0_0_3750_3000/master/3750.jpg?width=140&amp;quality=85&amp;auto=format&amp;fit=max&amp;s=e5620c45cf4b29b42ed906346159bdc1">
        <media:credit scheme="urn:ebu">Illustration: Guardian Pictures/Alamy</media:credit>
      </media:content>
      <media:content width="460" url="https://i.guim.co.uk/img/media/8e8d4ce7d37742836e3c3c5add2beb073cc8be21/0_0_3750_3000/master/3750.jpg?width=460&amp;quality=85&amp;auto=format&amp;fit=max&amp;s=f5eaf842630ee33c7a4a26ba7fe7022d">
