<?xml version="1.0" encoding="utf-8"?>
<!--
  The lyrics widget: the song in small dim type, 8dp over the line being sung in large white type, and the next line under
  it in the dim ink. The whole card opens the player. Lines wrap to two and end with an ellipsis rather than shrinking.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_lyrics_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/widget_lyrics_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_lyrics_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_lyrics_idle"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_lyrics_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#99FFFFFF"
        android:textSize="15sp" />
</LinearLayout>
