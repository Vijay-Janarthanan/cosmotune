<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Device-key stores cannot be opened after an OS restore; offline media is excluded too. -->
        <exclude domain="file" path="providers/" />
        <exclude domain="file" path="manga/" />
        <exclude domain="sharedpref" path="cosmotune_auth.xml" />
        <exclude domain="sharedpref" path="cosmotune_auth_plain.xml" />
        <exclude domain="sharedpref" path="cosmotune_sources.xml" />
        <exclude domain="sharedpref" path="cosmotune_sources_plain.xml" />
        <!-- the same stores under their names before the rename (kept on the device, never deleted: LegacyDataMigration) -->
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="bitchord_sources.xml" />
        <exclude domain="sharedpref" path="bitchord_sources_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-key stores cannot be opened after an OS restore; offline media is excluded too. -->
        <exclude domain="file" path="providers/" />
        <exclude domain="file" path="manga/" />
        <exclude domain="sharedpref" path="cosmotune_auth.xml" />
        <exclude domain="sharedpref" path="cosmotune_auth_plain.xml" />
        <exclude domain="sharedpref" path="cosmotune_sources.xml" />
        <exclude domain="sharedpref" path="cosmotune_sources_plain.xml" />
        <!-- the same stores under their names before the rename (kept on the device, never deleted: LegacyDataMigration) -->
        <exclude domain="sharedpref" path="bitchord_auth.xml" />
        <exclude domain="sharedpref" path="bitchord_auth_plain.xml" />
        <exclude domain="sharedpref" path="bitchord_sources.xml" />
        <exclude domain="sharedpref" path="bitchord_sources_plain.xml" />
    </device-transfer>
</data-extraction-rules>
