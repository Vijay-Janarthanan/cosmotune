<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public radio stations and publisher RSS enclosures can be HTTP-only.
         Credential-bearing provider SDK requests still enforce HTTPS in ProviderNetwork. -->
    <base-config cleartextTrafficPermitted="true" />
    <!-- Provider media is relayed by this process on an ephemeral loopback port.
         Remote provider requests retain their own HTTPS/domain/DNS checks. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
