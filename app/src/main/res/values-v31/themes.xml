<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system splash: black, with the launcher icon (the adaptive icon) on it, so only the
      mark is seen. This file replaces Theme.BitChord of values/ and values-night/ as a whole on API 31
      and up, so it repeats the parent and the black window background. values-night-v31/ is the same
      file: a night-mode folder outranks values-v31/ for a phone in dark mode, so each needs its own copy.
    -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>
</resources>
